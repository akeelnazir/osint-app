# Backend environment variables. Copy to .env and adjust.

# PostgreSQL connection string (with PostGIS enabled on the DB).
DATABASE_URL=postgres://osint:osint@localhost:5432/osint?sslmode=disable

# JWT secrets. CHANGE THESE in production.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# Token TTLs.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# File storage: "local" or "s3".
FILE_STORAGE=local
LOCAL_STORAGE_PATH=./uploads

# S3 (only used when FILE_STORAGE=s3).
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# App.
APP_ENV=development
HTTP_ADDR=:8080

# CORS: comma-separated list of allowed origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting (requests per second per IP).
RATE_LIMIT_RPS=20
